# Template only. Set real values through backend/.env or environment variables.
# APP_ENV=production enables startup validation. No Docker required.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studyonline_db
DB_USER=studyonline_app
DB_PASS=replace_with_database_password
JWT_SECRET=replace_with_your_private_jwt_secret
JWT_EXPIRE=604800
FRONTEND_ORIGIN=https://learn.example.com
FRONTEND_URL=https://learn.example.com
PUBLIC_BASE_URL=https://api.example.com
UPLOAD_DIR=./uploads
VNPAY_RETURN_URL=https://api.example.com/api/payments/vnpay/return
# Copy AI and VNPay credentials from your configured environment if required.
